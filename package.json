{
  "name": "domolyma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "site:build": "python3 scripts/build-site.py",
    "site:preview": "python3 -m http.server 5180 --bind 127.0.0.1 --directory dist/site",
    "dev": "python3 scripts/local-instance.py run --instance local",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "python3 scripts/local-instance.py migrate --instance local",
    "db:seed": "python3 scripts/local-instance.py seed --instance local",
    "setup": "python3 scripts/local-instance.py setup --instance local",
    "format": "prettier --write apps packages tests *.ts *.json *.jsonc",
    "dev:development": "python3 scripts/local-instance.py run --instance development",
    "setup:development": "python3 scripts/local-instance.py setup --instance development",
    "backup:local": "python3 scripts/local-instance.py backup --instance local",
    "backup:development": "python3 scripts/local-instance.py backup --instance development",
    "test:ops": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "start": "python3 scripts/local-instance.py start --instance local",
    "prepare:local": "python3 scripts/local-instance.py prepare --instance local",
    "manifest:check": "python3 scripts/project-manifest.py --check",
    "manifest:update": "python3 scripts/project-manifest.py",
    "pages:build": "tsc --noEmit && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "fflate": "0.8.3",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "1.15.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^5.20261019.2-beta",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
